<Window Icon="/OBDWorkbench;component/Assets/IcarusWorkbench.ico" x:Class="OBDWorkbench.SplashWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Icarus Offroad - OBD WorkBench" Width="1200" Height="720" WindowStartupLocation="Manual" MinWidth="360" MinHeight="300" UseLayoutRounding="True" Background="#111313">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>

   <!-- One continuous artwork layer; all foreground controls share its coordinate space. -->
   <Image x:Name="SplashBackgroundImage" Grid.RowSpan="4" Source="Assets/SplashConcept.png"
          Width="1160" Height="652.85" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False"/>
   <Border x:Name="SplashArtwork" Height="280" Background="Transparent"/>

   <!-- First-stage launcher. No connection status or progress UI is visible until a mode is selected. -->
   <Border x:Name="ModeSelectionPanel" Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="1040" Margin="12,0,12,10" Padding="12,12" Background="#DD111313" CornerRadius="10">
    <StackPanel>
     <TextBlock Text="Choose session mode" Foreground="#F3EEE3" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
     <TextBlock Text="Connect to a vehicle or replay a saved datalog." TextWrapping="Wrap" Foreground="#BDB7AD" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,18"/>
     <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal">
      <Button x:Name="ObdiiModeButton" Content="OBDII" Click="OBDII_Click" Width="150" Height="150" Margin="8" FontSize="24" FontWeight="SemiBold" Foreground="#F3EEE3" Background="#2B3030" BorderBrush="#D99A6C" BorderThickness="2"/>
      <Button x:Name="Td5ModeButton" Content="TD5" Click="TD5_Click" Width="150" Height="150" Margin="8" FontSize="24" FontWeight="SemiBold" Foreground="#F3EEE3" Background="#2B3030" BorderBrush="#D99A6C" BorderThickness="2"/>
      <Button x:Name="GemsModeButton" Content="GEMS" Click="GEMS_Click" Width="150" Height="150" Margin="8" FontSize="24" FontWeight="SemiBold" Foreground="#F3EEE3" Background="#2B3030" BorderBrush="#D99A6C" BorderThickness="2" ToolTip="Land Rover GEMS engine management • public test preview"/>
      <Button Content="DRB" IsEnabled="False" Width="150" Height="150" Margin="8" FontSize="24" FontWeight="SemiBold" Foreground="#8A8A8A" Background="#1B1D1D" BorderBrush="#555555" BorderThickness="1" Opacity="0.72"/>
      <Button x:Name="SsmModeButton" Content="SSM" Click="SSM_Click" Width="150" Height="150" Margin="8" FontSize="24" FontWeight="SemiBold" Foreground="#F3EEE3" Background="#2B3030" BorderBrush="#D99A6C" BorderThickness="2" ToolTip="Subaru Select Monitor 2 • native 4800-baud K-Line"/>
      <Button x:Name="ReplayModeButton" Content="Replay" Click="Replay_Click" Width="150" Height="150" Margin="8" FontSize="24" FontWeight="SemiBold" Foreground="#F3EEE3" Background="#2B3030" BorderBrush="#D99A6C" BorderThickness="2"/>
     </WrapPanel>
    </StackPanel>
   </Border>

   <!-- Second-stage connection UI appears after a live vehicle family is chosen. -->
   <Grid x:Name="ConnectionPhasePanel" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="ConnectionScroll" Margin="12,0" Background="#CC111313" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="280">
     <ContentControl x:Name="ConnectionHost"/>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Margin="26,10" Background="#99111313">
     <TextBlock x:Name="StartupStatus" Text="Waiting for connection mode…" Foreground="#F3EEE3" TextWrapping="Wrap"/>
     <ProgressBar Height="4" Margin="0,10" IsIndeterminate="True" Foreground="#D99A6C"/>
     <DockPanel>
      <Button Content="Stop search / edit settings" Click="Stop_Click" HorizontalAlignment="Left" Padding="16,6"/>
      <Button Content="Skip" Click="Skip_Click" HorizontalAlignment="Right" Padding="28,6"/>
     </DockPanel>
    </StackPanel>
   </Grid>

   <TextBlock Grid.Row="3" Margin="26,0,26,14" x:Name="VersionLabel" Foreground="#BDB7AD"/>
  </Grid>
 </ScrollViewer>
</Window>
