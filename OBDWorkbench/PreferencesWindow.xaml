<Window x:Class="OBDWorkbench.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preferences" Width="1050" Height="640" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Column="0" Grid.RowSpan="3" Width="24" Visibility="{DynamicResource LcarsFrameVisibility}" Background="{DynamicResource LcarsPeachBrush}" CornerRadius="16,0,0,16" Margin="0,0,8,0"/>
    <Border Grid.Column="1" Grid.Row="0" Visibility="{DynamicResource LcarsFrameVisibility}" Background="{DynamicResource LcarsLilacBrush}" CornerRadius="0,18,18,0" Padding="15,8" Margin="0,0,0,8"><TextBlock Text="LCARS  /  SYSTEM SETTINGS" FontFamily="Bahnschrift SemiCondensed" FontWeight="Bold" FontSize="23" Foreground="#10111C"/></Border>
    <TabControl Grid.Column="1" Grid.Row="1">
      <TabItem Header="General">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="10">
            <Button Content="GPS connection and NMEA debug…" Click="GpsSettings_Click" HorizontalAlignment="Left" Padding="10,6" Margin="0,0,0,12"/>
            <TextBlock Text="Appearance and behavior" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <CheckBox x:Name="IcarusThemeCheck" Content="Icarus charcoal, copper and ivory theme (overrides Windows theme)" Margin="0,3"/>
            <CheckBox x:Name="LcarsSkinCheck" Content="LCARS-inspired interface skin (overrides other theme choices)" Margin="0,3"/>
            <CheckBox x:Name="FollowThemeCheck" Content="Follow Windows light/dark theme" Margin="0,3"/>
            <CheckBox x:Name="ConfirmCommandsCheck" Content="Confirm disruptive AT commands" Margin="0,3"/>
            <CheckBox x:Name="AutoCollapseCheck" Content="Collapse connection controls after polling starts" Margin="0,3,0,16"/>
            <TextBlock Text="Global unit system" FontWeight="SemiBold"/>
            <ComboBox x:Name="UnitSystemCombo" Width="150" HorizontalAlignment="Left" Margin="0,5,0,14">
              <ComboBoxItem Content="Imperial"/><ComboBoxItem Content="Metric"/>
            </ComboBox>
            <TextBlock Text="Per-measurement overrides" FontWeight="SemiBold"/>
            <TextBlock Text="Default follows the global unit system." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,6"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <TextBlock Text="Temperature" Margin="0,5"/><ComboBox x:Name="TemperatureCombo" Grid.Column="1" Margin="0,2"/>
              <TextBlock Text="Pressure" Grid.Row="1" Margin="0,5"/><ComboBox x:Name="PressureCombo" Grid.Row="1" Grid.Column="1" Margin="0,2"/>
              <TextBlock Text="Speed" Grid.Row="2" Margin="0,5"/><ComboBox x:Name="SpeedCombo" Grid.Row="2" Grid.Column="1" Margin="0,2"/>
              <TextBlock Text="Distance" Grid.Row="3" Margin="0,5"/><ComboBox x:Name="DistanceCombo" Grid.Row="3" Grid.Column="1" Margin="0,2"/>
              <TextBlock Text="Air flow" Grid.Row="4" Margin="0,5"/><ComboBox x:Name="FlowCombo" Grid.Row="4" Grid.Column="1" Margin="0,2"/>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Polling priority">
        <Grid Margin="10">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="Choose which live PIDs get the limited diagnostic-bus bandwidth. Priority 5 (Live) fills otherwise-unused slots; 4 is favored background data; 1 is lowest priority." TextWrapping="Wrap" Margin="0,0,0,8"/>
          <TextBlock Grid.Row="1" Text="The PID's requested interval still acts as its normal target. Priority matters most when the link is saturated." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <DataGrid x:Name="PollingPriorityGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Request" Binding="{Binding Request}" IsReadOnly="True" Width="85"/>
              <DataGridTextColumn Header="Signal" Binding="{Binding Name}" IsReadOnly="True" Width="180" MinWidth="150"/>
              <DataGridTextColumn Header="Plain-English description / decoded values" Binding="{Binding Description}" IsReadOnly="True" Width="*" MinWidth="300"/>
              <DataGridTextColumn Header="Category" Binding="{Binding Category}" IsReadOnly="True" Width="145"/>
              <DataGridTextColumn Header="Default" Binding="{Binding DefaultPriority}" IsReadOnly="True" Width="65"/>
              <DataGridTemplateColumn Header="Polling priority" Width="160">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox ItemsSource="{Binding PriorityChoices}" SelectedItem="{Binding SelectedPriority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Reset polling priorities to defaults" Padding="10,4" Click="ResetPollingPriorities_Click"/>
          </StackPanel>
        </Grid>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancel" Width="82" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="Save" Width="82" IsDefault="True" Click="Save_Click"/>
    </StackPanel>
  </Grid>
</Window>
